{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug StormDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/stormdb-debug",
            "args": ["--version"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build: Debug",
            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false
            }
        },
        {
            "name": "Debug StormDB with ASAN",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/stormdb-asan",
            "args": ["--version"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "abort_on_error=1:detect_stack_use_after_return=1:check_initialization_order=1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build: ASAN"
        },
        {
            "name": "Debug StormDB (Attach to Process)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/bin/stormdb-debug",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug with Valgrind",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/valgrind",
            "args": [
                "--tool=memcheck",
                "--leak-check=full",
                "--show-leak-kinds=all",
                "--track-origins=yes",
                "--verbose",
                "--log-file=valgrind.log",
                "${workspaceFolder}/bin/stormdb-debug",
                "--version"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build: Debug"
        },
        {
            "name": "LLDB Debug StormDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/stormdb-debug",
            "args": ["--version"],
            "cwd": "${workspaceFolder}",
            "MIMode": "lldb",
            "preLaunchTask": "Build: Debug"
        }
    ]
}
